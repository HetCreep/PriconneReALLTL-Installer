<?xml version="1.0" encoding="utf-8"?>
<configuration>
    <configSections>
        <sectionGroup name="applicationSettings" type="System.Configuration.ApplicationSettingsGroup, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089">
            <section name="PriconneReALLTLInstaller.Properties.Settings" type="System.Configuration.ClientSettingsSection, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" requirePermission="false" />
        </sectionGroup>
        <sectionGroup name="userSettings" type="System.Configuration.UserSettingsGroup, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089">
            <section name="PriconneReALLTLInstaller.Properties.Settings" type="System.Configuration.ClientSettingsSection, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" allowExeDefinition="MachineToLocalUser" requirePermission="false" />
        </sectionGroup>
    </configSections>
    <startup> 
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
    </startup>
    <applicationSettings>
        <PriconneReALLTLInstaller.Properties.Settings>
            <setting name="configFiles" serializeAs="Xml">
                <value>
                    <ArrayOfString xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                        <string>BepInEx/config/AutoTranslatorConfig.ini</string>
                        <string>BepInEx/config/PriconneTLFixup.cfg</string>
                    </ArrayOfString>
                </value>
            </setting>
            <setting name="aboutText" serializeAs="String">
                <value>
Multi-Account · ALL-TL (EN/TH) edition — fork by HetCreep
Based on tynave/PriconneReTL-Installer
Inspired by touanu/PriconeTL_Updater

All assets used in this application are properties of CyberAgent, Inc., Cygames, Inc. / their respective creators.</value>
            </setting>
            <setting name="installMode" serializeAs="String">
                <value>Install</value>
            </setting>
            <setting name="installModeDescription" serializeAs="String">
                <value>Installs the translation patch.
Keeps config files, ignored files and 
any user created files already present.</value>
            </setting>
            <setting name="uninstallMode" serializeAs="String">
                <value>Uninstall</value>
            </setting>
            <setting name="uninstallModeDescription" serializeAs="String">
                <value>Removes the translation patch.
Keeps any user created files.
Depending on the options selected, keeps or removes config/ignored/interop files.</value>
            </setting>
            <setting name="reinstallMode" serializeAs="String">
                <value>Reinstall</value>
            </setting>
            <setting name="reinstallModeDescription" serializeAs="String">
                <value>Removes the translation patch, and then installs the latest version.
Keeps any user created files.
Depending on the options selected, keeps or removes config/ignored/interop files.</value>
            </setting>
            <setting name="updateMode" serializeAs="String">
                <value>Update</value>
            </setting>
            <setting name="updateModeDescription" serializeAs="String">
                <value>Updates the current translation patch installation by removing the the current version and installing the latest.
Keeps user files, as well as config/ignored files.</value>
            </setting>
            <setting name="disabledMode" serializeAs="String">
                <value>Disabled</value>
            </setting>
            <setting name="disabledModeDescription" serializeAs="String">
                <value>Operation disabled due to an error.
See log for details.</value>
            </setting>
            <setting name="launchMode" serializeAs="String">
                <value>Launch Game</value>
            </setting>
            <setting name="launchModeDescrption" serializeAs="String">
                <value>Launches the game using the selected launcher.</value>
            </setting>
            <setting name="noOperationMode" serializeAs="String">
                <value>No Operation</value>
            </setting>
            <setting name="noOperationModeDescription" serializeAs="String">
                <value>No operation selected.</value>
            </setting>
        </PriconneReALLTLInstaller.Properties.Settings>
    </applicationSettings>
  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <dependentAssembly>
        <assemblyIdentity name="System.Runtime.CompilerServices.Unsafe" publicKeyToken="b03f5f7f11d50a3a" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-6.0.0.0" newVersion="6.0.0.0" />
      </dependentAssembly>
    </assemblyBinding>
  </runtime>
  <userSettings>
    <PriconneReALLTLInstaller.Properties.Settings>
      <setting name="ignoreFiles" serializeAs="Xml">
        <value>
          <ArrayOfString xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
            <string>BepInEx/Translation/en/Text/_Postprocessors.txt</string>
            <string>BepInEx/Translation/en/Text/_Preprocessors.txt</string>
            <string>BepInEx/Translation/en/Text/_Substitutions.txt</string>
          </ArrayOfString>
        </value>
      </setting>
      <setting name="launchState" serializeAs="String">
        <value>False</value>
      </setting>
      <setting name="fastLauncherLink" serializeAs="String">
        <value />
      </setting>
      <setting name="LastKnownVersion" serializeAs="String">
        <value>1.5.0.0</value>
      </setting>
      <setting name="selectedPatchSource" serializeAs="String">
        <value>0</value>
      </setting>
      <setting name="checkForInstallerUpdates" serializeAs="String">
        <value>True</value>
      </setting>
      <setting name="showLogChecked" serializeAs="String">
        <value>False</value>
      </setting>
      <setting name="DMMConfigPath" serializeAs="String">
        <value />
      </setting>
      <setting name="GithubAPIKey" serializeAs="String">
        <value />
      </setting>
      <setting name="versionCacheJson" serializeAs="String">
        <value />
      </setting>
    </PriconneReALLTLInstaller.Properties.Settings>
  </userSettings>
</configuration>